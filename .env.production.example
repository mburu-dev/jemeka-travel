# ============================================================
# Jemeka Tours & Travel — Production Environment (Oracle + Cloudflare)
# Copy this file to .env in your Oracle VPS and fill in values
# ============================================================

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=https://api.jemekatoursandtravel.com

# --- Backend (Hono API) ---
FRONTEND_URL=https://jemekatoursandtravel.com
NODE_ENV=production

# --- Database ---
# Managed internally via Docker volume mount at /data/db/sqlite.db
# Do NOT change DB_FILE here — it is set in docker-compose.yml

# --- Authentication & Security ---
# Generate with: openssl rand -base64 32
JWT_SECRET=your_secure_jwt_secret_here

# --- Payment Provider (Paystack) ---
# Use LIVE keys for production
PAYSTACK_SECRET_KEY=sk_live_...
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_...

# --- Email Provider (Resend) ---
RESEND_API_KEY=re_...

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- NextAuth (Auth.js) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=https://jemekatoursandtravel.com

# --- Cloudflare Zero Trust Tunnel ---
# Obtain from: Cloudflare Dashboard > Zero Trust > Networks > Tunnels
# After creating your tunnel named "jemeka-tours", copy the token here
CLOUDFLARE_TUNNEL_TOKEN=ey...
