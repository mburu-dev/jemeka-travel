# OCI Production Environment Configuration

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Hono API Backend Configuration
FRONTEND_URL=https://yourdomain.com
NODE_ENV=production

# Database
# DB_FILE is managed internally in the docker-compose.yml via volume mounting

# Authentication & Security
# Generate a secure random string (e.g. openssl rand -base64 32)
JWT_SECRET=your_secure_jwt_secret_here

# Payment Provider (Paystack)
PAYSTACK_SECRET_KEY=sk_live_...

# Email Provider (Resend)
RESEND_API_KEY=re_...

# Google OAuth (If applicable)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Cloudflare Zero Trust Tunnel
# Obtain this token from your Cloudflare Zero Trust dashboard when creating a tunnel
CLOUDFLARE_TUNNEL_TOKEN=ey...
