# Database
DATABASE_URL="file:../../packages/db/local.db"
# Production (Turso): DATABASE_URL="libsql://your-db.turso.io"

# Turso auth token for production (libsql:// connections)
DATABASE_AUTH_TOKEN=

# Server
PORT=4000
NODE_ENV=development

# Frontend
# Production: https://jemekatours.com
FRONTEND_URL="http://localhost:3000"

# Auth
# AUTH_SECRET is required for production
# Generate one with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"

# OAuth Providers
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Email (Resend)
AUTH_RESEND_KEY="your-resend-api-key"

# Payments (Paystack)
PAYSTACK_SECRET_KEY="your-paystack-secret-key"
