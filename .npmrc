# Tell npm to install optional dependencies for ALL platforms/architectures,
# not just the current machine's platform. This ensures the lockfile (generated
# on Windows/macOS) includes the Linux native binaries required by:
#   - @tailwindcss/oxide        (Tailwind CSS v4 native Rust engine)
#   - @ast-grep/napi            (used by @opennextjs/cloudflare for AST patching)
#   - @rolldown/binding         (used by Vite/Vitest bundler)
#   - lightningcss              (used by Tailwind / Next.js CSS pipeline)
#   - @next/swc-*               (Next.js SWC compiler)
# Without this, `npm ci` on Linux CI runners fails with
# "Cannot find native binding" because the platform-specific .node files
# were never added to the lockfile.
os=any
cpu=any
