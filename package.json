{
  "name": "jemeka-travel",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "build": "turbo run build",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "test": "turbo run test",
    "postinstall": "node scripts/install-native-bindings.js"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "turbo": "^2.9.18"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "drizzle-orm": "^0.45.2"
  },
  "overrides": {
    "@libsql/client": "^0.17.3",
    "jose": "^6.2.3",
    "@payloadcms/db-sqlite": {
      "@libsql/client": "^0.17.3"
    },
    "payload": {
      "jose": "^6.2.3"
    }
  }
}
